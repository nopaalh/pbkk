<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrasi Mahasiswa"
        Width="1120" Height="760" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource PrimaryBrush}" DockPanel.Dock="Left">
                <TextBlock Text="M" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Registrasi Mahasiswa" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Kelola data mahasiswa dengan mudah" Foreground="#6B7280" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16,13" BorderBrush="#E7EAF0" BorderThickness="1">
                <StackPanel>
                <TextBlock Text="TOTAL MAHASISWA" FontSize="11" FontWeight="SemiBold" Foreground="#737B8C"/>
                <TextBlock x:Name="txtTotal" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16,13" BorderBrush="#E7EAF0" BorderThickness="1">
                <StackPanel><TextBlock Text="PROGRAM STUDI" FontSize="11" FontWeight="SemiBold" Foreground="#737B8C"/><TextBlock x:Name="txtProgram" Text="4 pilihan" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="16,13" BorderBrush="#E7EAF0" BorderThickness="1">
                <StackPanel><TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#737B8C"/><TextBlock Text="Siap digunakan" FontSize="20" FontWeight="Bold" Foreground="#0F8A68" Margin="0,7,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.88*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.12*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E7EAF0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Form Mahasiswa" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Lengkapi informasi mahasiswa di bawah ini." Foreground="#6B7280" Margin="0,5,0,20" />

                        <TextBlock Text="NIM" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <TextBox x:Name="txtNim" Height="40" />

                        <TextBlock Text="Nama Mahasiswa" FontWeight="SemiBold" Margin="0,16,0,7" />
                        <TextBox x:Name="txtNama" Height="40" />

                        <TextBlock Text="Program Studi" FontWeight="SemiBold" Margin="0,16,0,7" />
                        <ComboBox x:Name="cmbProdi" Height="40" SelectedIndex="-1">
                            <ComboBoxItem Content="Teknik Informatika" />
                            <ComboBoxItem Content="Sistem Informasi" />
                            <ComboBoxItem Content="Manajemen" />
                            <ComboBoxItem Content="Akuntansi" />
                        </ComboBox>

                        <TextBlock Text="Jenis Kelamin" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbLaki" Content="Laki-laki" GroupName="JenisKelamin" Margin="0,0,22,0" />
                            <RadioButton x:Name="rbPerempuan" Content="Perempuan" GroupName="JenisKelamin" />
                        </StackPanel>

                        <WrapPanel Margin="0,22,0,0">
                            <Button x:Name="btnSimpan" Content="Tambahkan Data" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="BtnSimpan_Click" Margin="0,0,8,8" />
                            <Button Content="Reset" Background="#F0F2F6" Foreground="#4B5563" Click="BtnReset_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E7EAF0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Daftar Mahasiswa" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="Pilih data untuk memperbarui atau menghapus." Foreground="#6B7280" Margin="0,5,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="txtCari" Grid.Row="1" Height="40" Margin="0,0,0,12" ToolTip="Cari berdasarkan NIM, nama, prodi, atau jenis kelamin" TextChanged="TxtCari_TextChanged" />
                    <ListBox x:Name="lstMahasiswa" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="LstMahasiswa_SelectionChanged" PreviewMouseLeftButtonDown="LstMahasiswa_PreviewMouseLeftButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FC" BorderBrush="#E8EBF2" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#E8EAFE">
                                            <TextBlock Text="{Binding Inisial}" Foreground="#4338CA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Nim, StringFormat='NIM {0}'}" Foreground="#737B8C" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Perbarui" Padding="10,6" Background="#E8EAFE" Foreground="#4338CA" Click="BtnPerbarui_Click" Margin="0,0,6,0" />
                                            <Button Content="Hapus" Padding="10,6" Background="#FEECEC" Foreground="#B42318" Click="BtnHapus_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
